# Copy to .env and fill in. Never commit .env (gitignored).

# === Content generation ===
ANTHROPIC_API_KEY=sk-ant-...

# === Images (free, real photos) ===
PEXELS_API_KEY=

# === Optional: web research ===
PERPLEXITY_API_KEY=

# === Per-site Vercel deploy hooks ===
# Project Settings → Git → Deploy Hooks
VERCEL_HOOK_SLEEPUPGRADEHUB=
VERCEL_HOOK_TRADINGHUB=
VERCEL_HOOK_AITOOLSEDGE=
VERCEL_HOOK_CODESTACKHUB=

# === IndexNow (Bing/Yandex/etc instant indexing) ===
INDEXNOW_KEY=

# === Affiliates ===
# Amazon Associates store ID / tag (e.g. sleepupgrade-20). When set, product
# posts show a tagged "On Amazon" buy button automatically. Also set it in
# Vercel env for production. Direct-brand links go in src/utils/affiliate.ts.
PUBLIC_AMAZON_TAG=

# === Contact form (Web3Forms — free, no backend) ===
# https://web3forms.com → create access key → paste here.
# Build-time only (Astro inlines at build); rotate freely.
PUBLIC_WEB3FORMS_KEY=

# === GitHub (for programmatic commits if needed) ===
GITHUB_OWNER=daperk
GITHUB_TOKEN=
